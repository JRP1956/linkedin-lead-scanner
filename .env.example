# Required
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5    # optional — any Claude model id
APOLLO_API_KEY=
HUBSPOT_ACCESS_TOKEN=

# Optional
SLACK_WEBHOOK_URL=              # if missing, Slack notifications are silently skipped
PORT=3001                       # default 3001

# SQLite
DB_PATH=./data/leads.db

# Monitor job
MONITOR_CRON_SCHEDULE=0 */6 * * *    # every 6 hours

# Playwright browser profile path
BROWSER_PROFILE_PATH=./browser-profile

# Signal Detection
CRUNCHBASE_API_KEY=             # optional — funding detection

# Auth
JWT_SECRET=                     # enables login — generate with: openssl rand -base64 32
                                # unset = single-user mode with NO login (only safe on your own machine)
CORS_ORIGIN=http://localhost:5173   # comma-separated origins allowed to call the API

# Safety limits (0 = no limit)
MAX_SCANS_PER_DAY=10            # LinkedIn scans (manual + monitor) per day

# Cost tracking — Claude cost is computed automatically; set these to include enrichment spend
APOLLO_COST_PER_CREDIT=0        # e.g. 0.05
