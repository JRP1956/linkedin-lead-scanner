# Required
ANTHROPIC_API_KEY=
APOLLO_API_KEY=
HUBSPOT_ACCESS_TOKEN=

# Optional
SLACK_WEBHOOK_URL=              # if missing, Slack notifications are silently skipped
PORT=3001                       # default 3001

# SQLite
DB_PATH=./data/leads.db

# Monitor job
MONITOR_CRON_SCHEDULE=0 */6 * * *    # every 6 hours

# Playwright browser profile path
BROWSER_PROFILE_PATH=./browser-profile

# Phase 2: Enrichment & Signal Detection
PROXYCURL_API_KEY=              # optional — deep LinkedIn profile enrichment
CRUNCHBASE_API_KEY=             # optional — funding detection

# Phase 3: Email Outreach
SMTP_HOST=                      # e.g. smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=                      # e.g. you@yourdomain.com

# Phase 5: CRM & Auth
PIPEDRIVE_API_TOKEN=            # optional — Pipedrive CRM integration
JWT_SECRET=                     # required for auth — generate with: openssl rand -base64 32
